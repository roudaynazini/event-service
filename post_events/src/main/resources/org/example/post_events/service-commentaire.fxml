<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.paint.LinearGradient?>
<?import javafx.scene.paint.Stop?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #f0f4f7;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.post_events.controllers.CommentaireController">
    <children>

        <Text layoutX="300.0" layoutY="30.0" style="-fx-font-size: 24px; -fx-font-weight: bold;" text="share your Comments">
         <fill>
            <LinearGradient endX="1.0" endY="1.0" startX="0.9004739336492891">
               <stops>
                  <Stop>
                     <color>
                        <Color red="0.45579999685287476" green="0.3179999887943268" blue="0.5299999713897705" />
                     </color>
                  </Stop>
                  <Stop offset="1.0">
                     <color>
                        <Color red="1.0" green="1.0" blue="1.0" />
                     </color>
                  </Stop>
               </stops>
            </LinearGradient>
         </fill></Text>

        <!-- Labels -->
        <Text layoutX="40.0" layoutY="100.0" style="-fx-font-size: 14px; -fx-font-weight: bold;" text="ID du Post" />
        <Text layoutX="40.0" layoutY="160.0" style="-fx-font-size: 14px; -fx-font-weight: bold;" text="ID USER" />
        <Text layoutX="40.0" layoutY="220.0" style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Contenu" />
        <Text layoutX="40.0" layoutY="280.0" style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Date" />

        <!-- TextFields -->
        <TextField fx:id="textfield_postId" layoutX="150.0" layoutY="80.0" prefWidth="250.0" promptText="Enter Post ID" />
        <TextField fx:id="textfield_userId" layoutX="150.0" layoutY="140.0" prefWidth="250.0" promptText="Enter User ID" />
        <TextField fx:id="textfield_content" layoutX="150.0" layoutY="200.0" prefWidth="250.0" promptText="Enter Comment Content" />
        <TextField fx:id="textfield_date" layoutX="150.0" layoutY="260.0" prefWidth="250.0" promptText="Enter Date (yyyy-MM-dd HH:mm:ss)" />

        <!-- Buttons -->
        <Button fx:id="button_create" layoutX="192.0" layoutY="322.0" onAction="#ajouter" prefWidth="100.0" style="-fx-background-color: #b583dc; -fx-text-fill: white;" text="Ajouter" />
        <Button fx:id="button_update" layoutX="192.0" layoutY="365.0" onAction="#updateDescription" prefWidth="100.0" style="-fx-background-color: #b583dc; -fx-text-fill: white;" text="Modifier" />
        <Button fx:id="button_delete" layoutX="192.0" layoutY="418.0" onAction="#delete" prefWidth="100.0" style="-fx-background-color: #b583dc; -fx-text-fill: white;" text="Supprimer" />
        <Button fx:id="button_search" layoutX="192.0" layoutY="468.0" onAction="#search" prefWidth="100.0" style="-fx-background-color: #b583dc; -fx-text-fill: black;" text="Rechercher" textFill="#fbffe7" />

        <!-- TableView -->
        <TableView fx:id="table_comments" layoutX="450.0" layoutY="80.0" prefHeight="400.0" prefWidth="400.0">
            <columns>
                <TableColumn fx:id="column_id" prefWidth="50.0" text="ID" />
                <TableColumn fx:id="column_postId" prefWidth="80.0" text="Post ID" />
                <TableColumn fx:id="column_userId" prefWidth="80.0" text="User ID" />
                <TableColumn fx:id="column_content" prefWidth="120.0" text="Content" />
                <TableColumn fx:id="column_date" prefWidth="70.0" text="Date" />
            </columns>
        </TableView>

    </children>
</AnchorPane>
