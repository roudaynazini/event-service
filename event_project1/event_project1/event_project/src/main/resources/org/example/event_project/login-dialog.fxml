<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.roudaynazini.LoginDialogController"
      spacing="10"
      style="-fx-background-color: #FFF0F5; -fx-padding: 20;">
    
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Login" style="-fx-font-size: 24px; -fx-text-fill: #C71585; -fx-font-weight: bold;"/>
    
    <Label text="Username:" style="-fx-text-fill: #C71585;"/>
    <TextField fx:id="usernameField" style="-fx-background-color: #9370DB; -fx-text-fill: #C71585;"/>
    
    <Label text="Password:" style="-fx-text-fill: #C71585;"/>
    <PasswordField fx:id="passwordField" style="-fx-background-color: #9370DB; -fx-text-fill: #C71585;"/>
    
    <Label fx:id="errorLabel" style="-fx-text-fill: #FF0000;"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Login" onAction="#handleLogin" style="-fx-background-color: #D8BFD8; -fx-text-fill: #C71585; -fx-font-weight: bold;"/>
        <Button text="Cancel" onAction="#handleCancel" style="-fx-background-color: #D8BFD8; -fx-text-fill: #C71585; -fx-font-weight: bold;"/>
    </HBox>
</VBox> 