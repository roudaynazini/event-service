<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="200.0" prefWidth="400.0" style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #f0c0f0, #ffffff);" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.event_project.Controllers.VerificationController">
    <children>

        <Label layoutX="50.0" layoutY="40.0" text="Entrez le code de vérification :">
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
        </Label>

        <TextField fx:id="codeField" layoutX="50.0" layoutY="80.0" prefWidth="300.0" style="-fx-background-radius: 10px; -fx-border-color: #a64ca6; -fx-font-size: 14px;" />

        <Button fx:id="verifyButton" layoutX="150.0" layoutY="130.0" onAction="#verifierCode" prefHeight="41.0" prefWidth="123.0" style="-fx-background-color: linear-gradient(to right, #d17bd1, #8e3b8e); -fx-text-fill: white; -fx-background-radius: 10px; -fx-font-size: 14px;" text="Vérifier" />

    </children>
</AnchorPane>
