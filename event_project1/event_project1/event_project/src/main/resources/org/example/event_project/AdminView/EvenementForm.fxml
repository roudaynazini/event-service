<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.event_project.Controllers.EvenementFormController"
      spacing="15.0" styleClass="form-container" stylesheets="@../css/admin.css">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>
    
    <Label text="Gérer un Événement" styleClass="form-title"/>
    
    <GridPane vgap="15" hgap="10">
        <columnConstraints>
            <ColumnConstraints prefWidth="120"/>
            <ColumnConstraints prefWidth="250"/>
            <ColumnConstraints prefWidth="50"/>
        </columnConstraints>
        
        <Label text="Titre:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="titreField" promptText="Titre de l'événement" GridPane.columnIndex="1" GridPane.rowIndex="0" GridPane.columnSpan="2"/>
        
        <Label text="Catégorie:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <ComboBox fx:id="categorieComboBox" prefWidth="250.0" GridPane.columnIndex="1" GridPane.rowIndex="1" GridPane.columnSpan="2"/>
        
        <Label text="Date de début:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <DatePicker fx:id="dateDebutPicker" prefWidth="250.0" promptText="Sélectionner une date" GridPane.columnIndex="1" GridPane.rowIndex="2" GridPane.columnSpan="2"/>
        
        <Label text="Date de fin:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <DatePicker fx:id="dateFinPicker" prefWidth="250.0" promptText="Sélectionner une date" GridPane.columnIndex="1" GridPane.rowIndex="3" GridPane.columnSpan="2"/>
        
        <Label text="Lieu:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
        <TextField fx:id="lieuField" promptText="Adresse de l'événement" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
        <Button fx:id="mapButton" onAction="#handleOpenMap" styleClass="map-btn" GridPane.columnIndex="2" GridPane.rowIndex="4">
            <graphic>
                <FontIcon iconLiteral="fas-map-marker-alt" iconSize="16" iconColor="#ffffff"/>
            </graphic>
        </Button>
        
        <Label text="Description:" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
        <TextArea fx:id="descriptionField" wrapText="true" prefRowCount="4" promptText="Description détaillée de l'événement" 
                 GridPane.columnIndex="1" GridPane.rowIndex="5" GridPane.columnSpan="2"/>
        
        <Label text="Statut:" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
        <ComboBox fx:id="statusComboBox" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="6" GridPane.columnSpan="2"/>
    </GridPane>
    
    <HBox spacing="10.0" alignment="CENTER_RIGHT">
        <Button fx:id="btnCancel" text="Annuler" onAction="#handleCancelAction" styleClass="cancel-btn">
            <graphic>
                <FontIcon iconLiteral="fas-times" iconSize="14" iconColor="#555555"/>
            </graphic>
        </Button>
        <Button fx:id="btnSave" text="Enregistrer" onAction="#handleSaveAction" styleClass="save-btn">
            <graphic>
                <FontIcon iconLiteral="fas-save" iconSize="14" iconColor="WHITE"/>
            </graphic>
        </Button>
    </HBox>
</VBox>
