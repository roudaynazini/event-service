<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.effect.*?>



<AnchorPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.event_project.Controllers.InvitationController"
            style="-fx-background-color: linear-gradient(to bottom right, #4b2a82, #bd4089);">

    <VBox spacing="15" alignment="TOP_CENTER" AnchorPane.topAnchor="20.0"
          AnchorPane.rightAnchor="20.0" AnchorPane.leftAnchor="20.0"
          AnchorPane.bottomAnchor="20.0">


        <Label fx:id="titreLabel" text="Gestion des Invitations"
               style="-fx-font-size: 34px; -fx-font-weight: bold; -fx-text-fill: white;"/>

        <!-- Champ Nom de l'événement -->
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Nom de l'événement:"
                   style="-fx-font-size: 16px; -fx-text-fill: white;"/>
        </HBox>
        <TextField fx:id="txtNomEvenement" prefHeight="30"
                   style="-fx-background-color: white; -fx-background-radius: 5;"/>

        <!-- Champ Date de l'événement -->
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Date de l'événement:"
                   style="-fx-font-size: 16px; -fx-text-fill: white;"/>
        </HBox>
        <HBox spacing="10">
            <DatePicker fx:id="datePickerEvenement" prefHeight="30" prefWidth="150"
                        style="-fx-background-color: white; -fx-background-radius: 5;"/>
            <ComboBox fx:id="comboDate" prefHeight="30" prefWidth="150" visible="false"
                      style="-fx-background-color: white; -fx-background-radius: 5;"/>
        </HBox>

        <!-- Champ Email invité -->
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Email invité:"
                   style="-fx-font-size: 16px; -fx-text-fill: white;"/>
        </HBox>
        <HBox alignment="CENTER_LEFT">
        <ComboBox fx:id="comboBoxEmails" prefHeight="30" prefWidth="150"
                  style="-fx-background-color: white; -fx-background-radius: 5;"/>
        </HBox>

        <!-- Champ Message -->
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Message:"
                   style="-fx-font-size: 16px; -fx-text-fill: white;"/>
        </HBox>
        <TextArea fx:id="txtMessage" prefHeight="80"
                  style="-fx-background-color: white; -fx-background-radius: 5;"/>



        <!-- Boutons des actions principales -->
        <HBox spacing="15" alignment="CENTER">
            <Button fx:id="ajouterButton" text="Ajouter" prefHeight="50" prefWidth="150"
                    style="-fx-background-color: linear-gradient(to right, #673ab7, #9c27b0); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;"/>

            <Button fx:id="modifierButton" text="Modifier" prefHeight="50" prefWidth="150"
                    style="-fx-background-color: linear-gradient(to right, #673ab7, #e91e63); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;"/>

            <!-- Supprimer fusionné avec champ ID -->
        </HBox>



        <!-- Champ ID à supprimer avec bouton intégré -->
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="ID à supprimer:"
                   style="-fx-font-size: 14px; -fx-text-fill: white;"/>
        </HBox>

        <HBox spacing="10">
            <TextField fx:id="txtIdSupprimer" prefWidth="100" prefHeight="3"
                       style="-fx-background-color: white; -fx-border-color: #e91e63; -fx-background-radius: 5; -fx-border-radius: 5;"/>
            <Button fx:id="supprimerButton" text="Supprimer" prefHeight="50" prefWidth="150"
                    style="-fx-background-color: linear-gradient(to right, #673ab7, #e91e63); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;"/>
        </HBox>

        <Label fx:id="statusMessage" textFill="white" style="-fx-font-size: 14px;"/>



        <!-- TableView -->
        <TableView fx:id="tableViewInvitation" prefHeight="250"
                   style="-fx-background-color: #b39bb2; -fx-table-cell-border-color: rgba(255,253,253,0.92); -fx-text-fill: #551e50;">
            <columns>
                <TableColumn fx:id="colIdInvitation" text="ID" prefWidth="50"/>
                <TableColumn fx:id="colNomEvenement" text="Nom événement" prefWidth="100"/>
                <TableColumn fx:id="colDateEvenement" text="Date" prefWidth="100"/>
                <TableColumn fx:id="colEmailInvitee" text="Email invité" prefWidth="100"/>
                <TableColumn fx:id="colMessage" text="Message" prefWidth="150"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>

        <!-- Bouton Retour -->
        <Button fx:id="retourButton" text="Retour" onAction="#handleRetour"
                prefHeight="50" prefWidth="300"
                style="-fx-background-color: linear-gradient(to right, #673ab7, #e91e63); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;"/>

    </VBox>
</AnchorPane>
