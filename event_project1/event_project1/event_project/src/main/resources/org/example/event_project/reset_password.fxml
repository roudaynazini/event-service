<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="305.0" prefWidth="460.0" style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #f0c0f0, #ffffff);" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.event_project.Controllers.ResetPasswordController">

    <children>

        <!-- Titre -->
        <Label layoutX="140.0" layoutY="30.0" text="Réinitialisation du Mot de Passe">
            <font>
                <Font name="Arial" size="18" />
            </font>
        </Label>

        <!-- Email Field -->
        <Label layoutX="50.0" layoutY="100.0" text="Entrez votre Email">
            <font>
                <Font name="Arial Bold" size="14.0" />
            </font>
        </Label>
        <TextField fx:id="emailField" layoutX="50.0" layoutY="130.0" prefWidth="300.0" promptText="exemple@domaine.com" style="-fx-background-color: #fce4ec; -fx-border-color: #ba68c8; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 6;" />

        <!-- Bouton de soumission -->
        <Button fx:id="submitButton" layoutX="150.0" layoutY="180.0" onAction="#handleSendCode" style="-fx-background-color: linear-gradient(to right, #ce64c8, #8e3b8e); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-border-radius: 20; -fx-background-radius: 20;" text="Envoyer le lien de réinitialisation" />

    </children>
</AnchorPane>
