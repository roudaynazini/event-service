<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="642.0" prefWidth="1123.0" style="-fx-background-color: #f0f4f7;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.event_project.Controllers.PostController">
    <children>
        <!-- Title -->
        <Text layoutX="247.0" layoutY="30.0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-fill: linear-gradient(to right, #6C3483,#A94ED1);" text="Partagez vos publications" />

        <!-- Labels -->
        <Text layoutX="10.0" layoutY="85.0" style="-fx-font-size: 14px; -fx-font-weight: bold;" text="ID utilisateur" />
        <Text layoutX="15.0" layoutY="161.0" style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Description" />
        <Text layoutX="8.0" layoutY="355.0" style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Date de Creation" />
        <Text layoutX="9.0" layoutY="405.0" style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Nombre de Reactions" />
        <Text layoutX="18.0" layoutY="458.0" style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Rechercher Post" />
        <Text layoutX="38.0" layoutY="574.0" style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Partagez vos souvenirs avec ceux que vous aimez" />
        <Text layoutX="435.0" layoutY="574.0" style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Double-cliquez pour afficher les commentaires de votre publication" wrappingWidth="474.951171875" />

        <!-- TextFields -->
        <TextField fx:id="textfield_userId" layoutX="98.0" layoutY="65.0" prefWidth="250.0" promptText="Enter User ID" style="-fx-background-radius: 10; -fx-padding: 5; -fx-background-color: white; -fx-border-color: #cccccc; -fx-border-radius: 10; -fx-border-width: 1;" />
        <TextField fx:id="textfield_description" layoutX="103.0" layoutY="115.0" prefHeight="131.0" prefWidth="250.0" promptText="Enter Description" style="-fx-background-radius: 10; -fx-padding: 5; -fx-background-color: white; -fx-border-color: #cccccc; -fx-border-radius: 10; -fx-border-width: 1;" />
        <TextField fx:id="textfield_dateCreation" layoutX="161.0" layoutY="335.0" prefWidth="250.0" promptText="Enter Date (yyyy-MM-dd)" style="-fx-background-radius: 10; -fx-padding: 5; -fx-background-color: white; -fx-border-color: #cccccc; -fx-border-radius: 10; -fx-border-width: 1;" />
        <TextField fx:id="textfield_nbReactions" layoutX="161.0" layoutY="385.0" prefWidth="250.0" promptText="Enter Nb Reactions" style="-fx-background-radius: 10; -fx-padding: 5; -fx-background-color: white; -fx-border-color: #cccccc; -fx-border-radius: 10; -fx-border-width: 1;" />
        <TextField fx:id="textfield_imagePath" editable="false" layoutX="12.0" layoutY="277.0" prefHeight="25.0" prefWidth="216.0" promptText="chemin" style="-fx-background-radius: 10; -fx-padding: 5; -fx-background-color: #e0e0e0; -fx-border-color: #cccccc; -fx-border-radius: 10; -fx-border-width: 1;" />
        <TextField fx:id="textfield_recherche" layoutX="140.0" layoutY="438.0" prefHeight="29.0" prefWidth="257.0" promptText="Search by IDUser..." style="-fx-background-radius: 10; -fx-padding: 5; -fx-background-color: white; -fx-border-color: #cccccc; -fx-border-radius: 10; -fx-border-width: 1;" />

        <!-- Buttons -->
        <Button fx:id="button_create" layoutX="13.0" layoutY="486.0" onAction="#ajouter" prefHeight="40.0" prefWidth="80.0" style="-fx-background-color: #b583dc; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 14px;" text="Ajouter">
            <tooltip><Tooltip text="Create a new post" /></tooltip>
        </Button>
        <Button fx:id="button_delete" layoutX="100.0" layoutY="486.0" onAction="#delete" prefHeight="40.0" prefWidth="100.0" style="-fx-background-color: #b583dc; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 14px;" text="Supprimer">
            <tooltip><Tooltip text="Delete selected post" /></tooltip>
        </Button>
        <Button fx:id="button_update" layoutX="207.0" layoutY="486.0" onAction="#updateDescription" prefHeight="40.0" prefWidth="80.0" style="-fx-background-color: #b583dc; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 14px;" text="Modifier">
            <tooltip><Tooltip text="Update selected post" /></tooltip>
        </Button>
        <Button fx:id="button_search" layoutX="296.0" layoutY="486.0" onAction="#rechercherPost" prefHeight="40.0" prefWidth="100.0" style="-fx-background-color: #b583dc; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 14px;" text="Rechercher">
            <tooltip><Tooltip text="Search posts" /></tooltip>
        </Button>
        <Button layoutX="247.0" layoutY="277.0" onAction="#chooseImageForPost" style="-fx-background-color: #b583dc; -fx-text-fill: white; -fx-background-radius: 8;" text="Choisir image" />
        <Button fx:id="likeButton" layoutX="512.0" layoutY="589.0" onAction="#handleLike" prefHeight="40.0" prefWidth="100.0" style="-fx-background-color: #00b300; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 18px;" text="👍 Like">
            <tooltip><Tooltip text="Like this post" /></tooltip>
        </Button>
        <Button fx:id="dislikeButton" layoutX="633.0" layoutY="589.0" onAction="#handleDislike" prefHeight="40.0" prefWidth="100.0" style="-fx-background-color: #ff4d4d; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 18px;" text="👎 Dislike">
            <tooltip><Tooltip text="Dislike this post" /></tooltip>
        </Button>
        <Button fx:id="btnPartager" layoutX="80.0" layoutY="589.0" onAction="#onPartagerClicked" style="-fx-background-color: #b583dc; -fx-text-fill: white; -fx-background-radius: 8;" text="Partager ce post sur WhatsApp" />

        <!-- TableView -->
        <TableView fx:id="tableview_post" layoutX="411.0" layoutY="39.0" prefHeight="505.0" prefWidth="643.0" style="-fx-background-color: white; -fx-border-color: #cccccc; -fx-border-radius: 10; -fx-border-width: 1; -fx-background-radius: 10;">
            <columns>
                <TableColumn fx:id="column_id" prefWidth="60.0" text="ID" />
                <TableColumn fx:id="column_userId" prefWidth="80.0" text="User ID" />
                <TableColumn fx:id="column_description" prefWidth="171.0" text="Description" />
                <TableColumn fx:id="column_dateCreation" prefWidth="88.0" text="Date" />
                <TableColumn fx:id="column_nbReactions" prefWidth="83.0" text="Nb Reactions" />
                <TableColumn fx:id="column_imagePath" prefWidth="159.0" text="imagePath" />
            </columns>
        </TableView>
    </children>
</AnchorPane>
