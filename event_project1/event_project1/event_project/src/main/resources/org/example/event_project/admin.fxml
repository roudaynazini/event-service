<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600" prefWidth="941.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.event_project.Controllers.AdminController">

    <!-- Bande supérieure -->
    <HBox prefHeight="80.0" prefWidth="941.0" style="-fx-background-color: linear-gradient(to right, #9b4de0, #e44abc); -fx-padding: 10;">
        <children>
            <VBox spacing="3" style="-fx-padding: 0 0 0 10;">
                <Label text="Admin Panel" textFill="white">
                    <font>
                        <Font name="Arial Black" size="20.0" />
                    </font>
                </Label>
            </VBox>
        </children>
    </HBox>

    <!-- Champ de recherche par ID -->
    <TextField fx:id="searchFieldID" layoutX="20" layoutY="100" prefWidth="200" promptText="Rechercher par ID" style="-fx-font-size: 14px; -fx-font-family: Arial, sans-serif; -fx-padding: 5;" />

    <!-- Table View -->
    <TableView fx:id="tableView" layoutX="20.0" layoutY="151.0" prefHeight="438.0" prefWidth="907.0" style="-fx-font-size: 14px; -fx-font-family: Arial, sans-serif;">
        <columns>
            <TableColumn fx:id="idCol" prefWidth="70.0" text="ID" />
            <TableColumn fx:id="nomCol" prefWidth="91.0" text="Nom" />
            <TableColumn fx:id="prenomCol" prefWidth="115.0" text="Prénom" />
            <TableColumn fx:id="emailCol" prefWidth="153.0" text="Email" />
            <TableColumn fx:id="telCol" prefWidth="133.0" text="Téléphone" />
            <TableColumn fx:id="ageCol" prefWidth="76.0" text="Âge" />
            <TableColumn fx:id="motdepasseCol" prefWidth="202.0" text="Mot de Passe" />
        </columns>
    </TableView>

    <!-- Bouton Rechercher -->
    <Button fx:id="searchButton" layoutX="227.0" layoutY="93.0" onAction="#handleRechercher" style="-fx-background-color: linear-gradient(to right, #ce64c8, #8e3b8e); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-border-radius: 20; -fx-background-radius: 20; -fx-padding: 10;" text="Rechercher" />

    <!-- Bouton Supprimer -->
    <Button fx:id="deleteButton" layoutX="328.0" layoutY="93.0" onAction="#supprimer" style="-fx-background-color: linear-gradient(to right, #ce64c8, #8e3b8e); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-border-radius: 20; -fx-background-radius: 20; -fx-padding: 10;" text="Supprimer" />

    <Button fx:id="telechargerPdfButton" layoutX="634.0" layoutY="93.0" onAction="#telechargerPdf" style="-fx-background-color: linear-gradient(to right, #ce64c8, #8e3b8e); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-border-radius: 20; -fx-background-radius: 20; -fx-padding: 10;" text="Télécharger PDF" />
    <!-- Bouton Modifier -->
    <Button fx:id="modifierButton" layoutX="424.0" layoutY="93.0" onAction="#ouvrirInterfaceModifier" style="-fx-background-color: linear-gradient(to right, #ce64c8, #8e3b8e);                -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;                -fx-border-radius: 20; -fx-background-radius: 20; -fx-padding: 10;" text="Modifier" />
    <Button fx:id="logoutButton" layoutX="502.0" layoutY="93.0" mnemonicParsing="false" onAction="#handleLogout" prefHeight="40.0" prefWidth="128.0" style="-fx-background-color: linear-gradient(to right, #ce64c8, #8e3b8e); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-border-radius: 20; -fx-background-radius: 20;" text="Déconnexion" />
   <Button fx:id="searchButton1" layoutX="779.0" layoutY="93.0" onAction="#go_to_event" style="-fx-background-color: linear-gradient(to right, #ce64c8, #8e3b8e); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-border-radius: 20; -fx-background-radius: 20; -fx-padding: 10;" text="Event" />

</AnchorPane>
