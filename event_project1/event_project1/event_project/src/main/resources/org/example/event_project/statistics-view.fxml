<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.event_project.StatisticsViewController"
      spacing="10"
      style="-fx-background-color: #FFF0F5;"
      stylesheets="@styles.css">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Title -->
    <Label text="Reservation Statistics" style="-fx-font-size: 24px; -fx-text-fill: #C71585; -fx-font-weight: bold;"/>

    <!-- Statistics Summary -->
    <GridPane hgap="20" vgap="10" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 5; -fx-border-color: #9370DB; -fx-border-radius: 5;">
        <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
        </columnConstraints>
        <rowConstraints>
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
        </rowConstraints>

        <Label fx:id="totalReservationsLabel" text="Total: 0" style="-fx-text-fill: #C71585; -fx-font-weight: bold;" GridPane.columnIndex="0"/>
        <Label fx:id="confirmedReservationsLabel" text="Confirmed: 0" style="-fx-text-fill: #C71585; -fx-font-weight: bold;" GridPane.columnIndex="1"/>
        <Label fx:id="pendingReservationsLabel" text="Pending: 0" style="-fx-text-fill: #C71585; -fx-font-weight: bold;" GridPane.columnIndex="2"/>
        <Label fx:id="cancelledReservationsLabel" text="Cancelled: 0" style="-fx-text-fill: #C71585; -fx-font-weight: bold;" GridPane.columnIndex="3"/>
        <Label fx:id="completedReservationsLabel" text="Completed: 0" style="-fx-text-fill: #C71585; -fx-font-weight: bold;" GridPane.columnIndex="4"/>
    </GridPane>

    <!-- Charts -->
    <HBox spacing="20" VBox.vgrow="ALWAYS">
        <PieChart fx:id="reservationPieChart" title="Status Distribution" prefWidth="400" prefHeight="300"/>
        <BarChart fx:id="reservationBarChart" title="Status Count" prefWidth="400" prefHeight="300">
            <xAxis>
                <CategoryAxis label="Status"/>
            </xAxis>
            <yAxis>
                <NumberAxis label="Count"/>
            </yAxis>
        </BarChart>
    </HBox>

    <!-- Close Button -->
    <HBox alignment="CENTER_RIGHT">
        <Button text="Close" onAction="#handleClose" style="-fx-background-color: #D8BFD8; -fx-text-fill: #C71585; -fx-font-weight: bold;"/>
    </HBox>
</VBox> 