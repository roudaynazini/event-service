<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="600.0" prefWidth="917.0" styleClass="main-pane" stylesheets="@test.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.event_project.Controllers.ManageSponsor">
    <children>
        <Text layoutX="280.0" layoutY="30.0" style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Manage Sponsors" />

        <Button fx:id="button_creat" layoutX="12.0" layoutY="547.0" mnemonicParsing="false" onAction="#addsponsor" prefHeight="40.0" prefWidth="93.0" style="-fx-background-color: #ff99ff; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 14px;" text="Create">
            <tooltip><Tooltip text="Create a new sponsor" /></tooltip>
        </Button>

        <Button fx:id="button_delete" layoutX="120.0" layoutY="549.0" mnemonicParsing="false" onAction="#deletsponsor" prefHeight="40.0" prefWidth="94.0" style="-fx-background-color: #ff99ff; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 14px;" text="Delete">
            <tooltip><Tooltip text="Delete selected sponsor" /></tooltip>
        </Button>

        <Button fx:id="button_update" layoutX="233.0" layoutY="549.0" mnemonicParsing="false" onAction="#updatesponsor" prefHeight="40.0" prefWidth="94.0" style="-fx-background-color: #ff99ff; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 14px;" text="Update">
            <tooltip><Tooltip text="Update selected sponsor" /></tooltip>
        </Button>

        <Button fx:id="button_search" layoutX="349.0" layoutY="549.0" mnemonicParsing="false" onAction="#searchsponsor" prefHeight="40.0" prefWidth="94.0" style="-fx-background-color: #ff99ff; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 14px;" text="Search">
            <tooltip><Tooltip text="Search sponsors" /></tooltip>
        </Button>

        <Text layoutX="40.0" layoutY="121.0" strokeType="OUTSIDE" strokeWidth="0.0" style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Name" />
        <Text layoutX="40.0" layoutY="173.0" strokeType="OUTSIDE" strokeWidth="0.0" style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Logo URL" />
        <Text layoutX="40.0" layoutY="238.0" strokeType="OUTSIDE" strokeWidth="0.0" style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Website" />
        <Text layoutX="40.0" layoutY="296.0" strokeType="OUTSIDE" strokeWidth="0.0" style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Description" />

        <TextField fx:id="textfiled_name" layoutX="139.0" layoutY="103.0" prefWidth="250.0" promptText="Enter Sponsor Name" style="-fx-background-radius: 10; -fx-padding: 5; -fx-background-color: white; -fx-border-color: #cccccc; -fx-border-radius: 10; -fx-border-width: 1;">
            <tooltip><Tooltip text="Enter sponsor name" /></tooltip>
        </TextField>

        <TextField fx:id="textfiled_logourl" layoutX="139.0" layoutY="156.0" prefWidth="250.0" promptText="Enter Logo URL" style="-fx-background-radius: 10; -fx-padding: 5; -fx-background-color: white; -fx-border-color: #cccccc; -fx-border-radius: 10; -fx-border-width: 1;">
            <tooltip><Tooltip text="Enter logo URL" /></tooltip>
        </TextField>

        <TextField fx:id="textfiled_website" layoutX="139.0" layoutY="221.0" prefWidth="250.0" promptText="Enter Website" style="-fx-background-radius: 10; -fx-padding: 5; -fx-background-color: white; -fx-border-color: #cccccc; -fx-border-radius: 10; -fx-border-width: 1;">
            <tooltip><Tooltip text="Enter website URL" /></tooltip>
        </TextField>

        <TextField fx:id="textfiled_description" layoutX="139.0" layoutY="279.0" prefWidth="250.0" promptText="Enter Description" style="-fx-background-radius: 10; -fx-padding: 5; -fx-background-color: white; -fx-border-color: #cccccc; -fx-border-radius: 10; -fx-border-width: 1;">
            <tooltip><Tooltip text="Enter sponsor description" /></tooltip>
        </TextField>

        <Text layoutX="100.0" layoutY="400.0" style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Search Sponsors" />

        <TextField fx:id="textfiled_search" layoutX="100.0" layoutY="420.0" prefWidth="300.0" promptText="Search sponsor by name..." style="-fx-background-radius: 10; -fx-padding: 5; -fx-background-color: white; -fx-border-color: #cccccc; -fx-border-radius: 10; -fx-border-width: 1;">
            <tooltip><Tooltip text="Search sponsors by name" /></tooltip>
        </TextField>

        <TableView fx:id="tableviwsponser" layoutX="420.0" layoutY="48.0" prefHeight="482.0" prefWidth="408.0" style="-fx-background-color: white; -fx-border-color: #cccccc; -fx-border-radius: 10; -fx-border-width: 1; -fx-background-radius: 10;">
            <columns>
            <TableColumn fx:id="afichhe_id" prefWidth="80.0" text="id" />
                <TableColumn fx:id="afichhe_name" prefWidth="80.0" text="Name" />
                <TableColumn fx:id="afichhe_url" prefWidth="80.0" text="Logo URL" />
                <TableColumn fx:id="afichhe_website" prefWidth="80.0" text="Website" />
                <TableColumn fx:id="afichhe_descriptin" prefWidth="80.0" text="Description" />
            </columns>
        </TableView>
      <Button fx:id="manageivent" layoutX="505.0" layoutY="549.0" mnemonicParsing="false" onAction="#gottomanageivent" prefHeight="40.0" prefWidth="300.0" style="-fx-background-color: #ff99ff; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 14px;" text="take me to mange cart">
         <tooltip>
            <Tooltip text="Search sponsors" />
         </tooltip>
      </Button>
      <Button fx:id="button_search1" layoutX="11.0" layoutY="4.0" mnemonicParsing="false" onAction="#go_to_home" prefHeight="40.0" prefWidth="149.0" style="-fx-background-color: #ff99ff; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 14px;" text="take me home ">
         <tooltip>
            <Tooltip text="Search sponsors" />
         </tooltip>
      </Button>
    </children>

</AnchorPane>
