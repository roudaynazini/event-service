<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:id="anchorPane" fx:controller="org.example.controller.StatistiquesController" stylesheets="@/resources/css/style.css">
    <!-- Titre -->
    <Label text="Statistiques des Avis" layoutX="50" layoutY="20" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-fill: linear-gradient(to bottom, #f4b6d8, #c47b8c, #9f4263); -fx-font-family: 'Roboto', sans-serif;"/>

    <!-- Graphique à barres : Nombre d'avis par jour -->
    <BarChart fx:id="barChart" layoutX="50" layoutY="80" prefWidth="600" prefHeight="400">
        <xAxis>
            <CategoryAxis fx:id="xAxis"/>
        </xAxis>
        <yAxis>
            <NumberAxis fx:id="yAxis" label="Nombre d'avis"/>
        </yAxis>
    </BarChart>

    <!-- Graphique circulaire : Répartition des notes -->
    <PieChart fx:id="pieChart" layoutX="700" layoutY="80" prefWidth="400" prefHeight="400"/>

    <!-- Bouton Retour -->
    <Button onAction="#passerAavis" text="Retour" style="-fx-background-color: linear-gradient(to bottom, #DDA0DD, #A94ED1, #6C3483); -fx-text-fill: white; -fx-font-size: 18px; -fx-background-radius: 25px; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 6, 0.5, 0, 2);" layoutX="50" layoutY="520"/>
</AnchorPane>
