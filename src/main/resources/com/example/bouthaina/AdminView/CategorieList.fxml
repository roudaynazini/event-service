<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.bouthaina.BackOffice.controllers.CategorieListController"
      spacing="10.0" stylesheets="@../css/admin.css">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>
    
    <HBox alignment="CENTER_LEFT" spacing="20.0">
        <Label text="Gestion des Catégories" styleClass="page-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnAjouter" text="Ajouter une Catégorie" onAction="#handleAddAction" styleClass="add-btn"/>
    </HBox>
    
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
        <FlowPane fx:id="categoriesContainer" hgap="15" vgap="15" styleClass="cards-container">
            <padding>
                <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
            </padding>
        </FlowPane>
    </ScrollPane>
</VBox>
