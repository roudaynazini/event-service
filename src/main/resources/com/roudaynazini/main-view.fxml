<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.paint.Color?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.roudaynazini.MainViewController"
      spacing="10"
      style="-fx-background-color: #FFF0F5;">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Top Bar -->
    <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: #9370DB; -fx-padding: 10; -fx-background-radius: 5;">
        <Label text="Event Up : Event Planning" style="-fx-font-size: 24px; -fx-text-fill: #C71585; -fx-font-weight: bold;"/>
    </HBox>

    <!-- Main Content Area -->
    <HBox spacing="20" VBox.vgrow="ALWAYS">
        <!-- Left Sidebar -->
        <VBox fx:id="menuVBox" spacing="10" style="-fx-background-color: #9370DB; -fx-padding: 15; -fx-background-radius: 5;" prefWidth="200">
            <Label text="Menu" style="-fx-font-size: 18px; -fx-text-fill: #C71585; -fx-font-weight: bold;"/>
            <Button text="Reservations" onAction="#handleShowReservations" style="-fx-background-color: #D8BFD8; -fx-text-fill: #C71585; -fx-font-weight: bold; -fx-min-width: 180; -fx-alignment: CENTER_LEFT; -fx-padding: 10;"/>
            <Button text="Contracts" onAction="#handleShowContracts" style="-fx-background-color: #D8BFD8; -fx-text-fill: #C71585; -fx-font-weight: bold; -fx-min-width: 180; -fx-alignment: CENTER_LEFT; -fx-padding: 10;"/>
            <Button text="Login" onAction="#handleSwitchRole" style="-fx-background-color: #D8BFD8; -fx-text-fill: #C71585; -fx-font-weight: bold; -fx-min-width: 180; -fx-alignment: CENTER_LEFT; -fx-padding: 10;"/>
        </VBox>

        <!-- Main Content -->
        <StackPane HBox.hgrow="ALWAYS">
            <!-- Reservations Section -->
            <VBox fx:id="reservationsSection" spacing="10" visible="true">
                <!-- Reservation Search and Filter Section -->
                <VBox spacing="10" style="-fx-background-color: #FFF0F5; -fx-padding: 15; -fx-background-radius: 5; -fx-border-color: #9370DB; -fx-border-radius: 5;">
                    <Label text="Recherche et Filtres" style="-fx-font-size: 18px; -fx-text-fill: #C71585; -fx-font-weight: bold;"/>
                    <GridPane hgap="10" vgap="10">
                        <columnConstraints>
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                        </rowConstraints>

                        <Label text="Recherche:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-text-fill: #C71585;"/>
                        <TextField fx:id="reservationSearchField" GridPane.columnIndex="1" GridPane.rowIndex="0" style="-fx-background-color: #9370DB; -fx-text-fill: #C71585;"/>
                        <ComboBox fx:id="reservationStatusFilter" promptText="Filtrer par statut" GridPane.columnIndex="2" GridPane.rowIndex="0" style="-fx-background-color: #9370DB; -fx-text-fill: #C71585;"/>
                        <DatePicker fx:id="reservationDateFilter" promptText="Filtrer par date" GridPane.columnIndex="3" GridPane.rowIndex="0" style="-fx-background-color: #9370DB; -fx-text-fill: #C71585;"/>
                    </GridPane>

                    <HBox spacing="10" alignment="CENTER_RIGHT">
                        <Button text="Reset Filters" onAction="#handleClearContractFilters" style="-fx-background-color: #D8BFD8; -fx-text-fill: #C71585; -fx-font-weight: bold;"/>
                    </HBox>
                </VBox>

                <!-- Reservation Table Section -->
                <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 5; -fx-border-color: #9370DB; -fx-border-radius: 5;" VBox.vgrow="ALWAYS">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Liste des Réservations" style="-fx-font-size: 18px; -fx-text-fill: #C71585; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Ajouter" onAction="#handleNewReservation" style="-fx-background-color: #D8BFD8; -fx-text-fill: #C71585; -fx-font-weight: bold;"/>
                        <Button text="Modifier" onAction="#handleEditReservation" style="-fx-background-color: #D8BFD8; -fx-text-fill: #C71585; -fx-font-weight: bold;"/>
                        <Button text="Supprimer" onAction="#handleDeleteReservation" style="-fx-background-color: #D8BFD8; -fx-text-fill: #C71585; -fx-font-weight: bold;"/>
                        <Button text="Voir Contrats" onAction="#handleViewContractsForReservation" styleClass="admin-only" style="-fx-background-color: #D8BFD8; -fx-text-fill: #C71585; -fx-font-weight: bold;"/>
                        <Button text="Calendar" onAction="#handleShowCalendar" styleClass="admin-only" style="-fx-background-color: #D8BFD8; -fx-text-fill: #C71585; -fx-font-weight: bold;"/>
                    </HBox>

                    <TableView fx:id="reservationTable" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="idColumn" text="ID" style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="nameColumn" text="Client Name" style="-fx-alignment: CENTER-LEFT;"/>
                            <TableColumn fx:id="dateColumn" text="Event Date" style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="statusColumn" text="Status" style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="notesColumn" text="Notes" style="-fx-alignment: CENTER-LEFT;"/>
                        </columns>
                        <style>
                            /* Table header style */
                            -fx-background-color: white;
                            -fx-border-color: #9370DB;
                            -fx-border-width: 1;
                            -fx-border-radius: 5;
                            
                            /* Selected row style */
                            -fx-selection-bar: #DDA0DD;
                            -fx-selection-bar-non-focused: #E6E6FA;
                            
                            /* Table cell style */
                            .table-row-cell {
                                -fx-background-color: transparent;
                                -fx-border-color: transparent transparent #E6E6FA transparent;
                                -fx-border-width: 0 0 1 0;
                            }
                            
                            .table-row-cell:selected {
                                -fx-background-color: #DDA0DD;
                            }
                            
                            .table-row-cell:selected .table-cell {
                                -fx-text-fill: #4B0082;
                            }
                            
                            /* Column header style */
                            .column-header {
                                -fx-background-color: #9370DB;
                                -fx-text-fill: white;
                                -fx-font-weight: bold;
                            }
                            
                            .column-header .label {
                                -fx-text-fill: white;
                            }
                        </style>
                    </TableView>
                </VBox>
            </VBox>

            <!-- Contracts Section -->
            <VBox fx:id="contractsSection" spacing="10" visible="false">
                <!-- Contract Search and Filter Section -->
                <VBox spacing="10" style="-fx-background-color: #FFF0F5; -fx-padding: 15; -fx-background-radius: 5; -fx-border-color: #9370DB; -fx-border-radius: 5;">
                    <Label text="Recherche et Filtres" style="-fx-font-size: 18px; -fx-text-fill: #C71585; -fx-font-weight: bold;"/>
                    <GridPane hgap="10" vgap="10">
                        <columnConstraints>
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                        </rowConstraints>

                        <Label text="Recherche:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-text-fill: #C71585;"/>
                        <TextField fx:id="contractSearchField" GridPane.columnIndex="1" GridPane.rowIndex="0" style="-fx-background-color: #9370DB; -fx-text-fill: #C71585;"/>
                        <ComboBox fx:id="contractTypeFilter" promptText="Filtrer par type" GridPane.columnIndex="2" GridPane.rowIndex="0" style="-fx-background-color: #9370DB; -fx-text-fill: #C71585;"/>
                        <ComboBox fx:id="contractStatusFilter" promptText="Filtrer par statut" GridPane.columnIndex="3" GridPane.rowIndex="0" style="-fx-background-color: #9370DB; -fx-text-fill: #C71585;"/>
                    </GridPane>

                    <HBox spacing="10" alignment="CENTER_RIGHT">
                        <Button text="Reset Filters" onAction="#handleClearContractFilters" style="-fx-background-color: #D8BFD8; -fx-text-fill: #C71585; -fx-font-weight: bold;"/>
                    </HBox>
                </VBox>

                <!-- Contract Table Section -->
                <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 5; -fx-border-color: #9370DB; -fx-border-radius: 5;" VBox.vgrow="ALWAYS">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Liste des Contrats" style="-fx-font-size: 18px; -fx-text-fill: #C71585; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Ajouter" onAction="#handleAddContract" style="-fx-background-color: #D8BFD8; -fx-text-fill: #C71585; -fx-font-weight: bold;"/>
                        <Button text="Modifier" onAction="#handleEditContract" style="-fx-background-color: #D8BFD8; -fx-text-fill: #C71585; -fx-font-weight: bold;"/>
                        <Button text="Supprimer" onAction="#handleDeleteContract" style="-fx-background-color: #D8BFD8; -fx-text-fill: #C71585; -fx-font-weight: bold;"/>
                        <Button text="Voir Réservation" onAction="#handleViewReservationForContract" style="-fx-background-color: #D8BFD8; -fx-text-fill: #C71585; -fx-font-weight: bold;"/>
                    </HBox>

                    <TableView fx:id="contractTable" VBox.vgrow="ALWAYS" style="-fx-background-color: #F8F0FF;">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
        <columns>
                            <TableColumn fx:id="contractIdColumn" text="ID" style="-fx-background-color: #9370DB; -fx-text-fill: #C71585; -fx-border-width: 0 1 0 0; -fx-border-color: white;"/>
                            <TableColumn fx:id="contractNumberColumn" text="Numéro" style="-fx-background-color: #9370DB; -fx-text-fill: #C71585; -fx-border-width: 0 1 0 0; -fx-border-color: white;"/>
                            <TableColumn fx:id="contractTypeColumn" text="Type" style="-fx-background-color: #9370DB; -fx-text-fill: #C71585; -fx-border-width: 0 1 0 0; -fx-border-color: white;"/>
                            <TableColumn fx:id="contractStatusColumn" text="Statut" style="-fx-background-color: #9370DB; -fx-text-fill: #C71585; -fx-border-width: 0 1 0 0; -fx-border-color: white;"/>
                            <TableColumn fx:id="contractStartDateColumn" text="Date Début" style="-fx-background-color: #9370DB; -fx-text-fill: #C71585; -fx-border-width: 0 1 0 0; -fx-border-color: white;"/>
                            <TableColumn fx:id="contractEndDateColumn" text="Date Fin" style="-fx-background-color: #9370DB; -fx-text-fill: #C71585; -fx-border-width: 0 1 0 0; -fx-border-color: white;"/>
                            <TableColumn fx:id="contractReservationIdColumn" text="ID Réservation" style="-fx-background-color: #9370DB; -fx-text-fill: #C71585; -fx-border-width: 0 1 0 0; -fx-border-color: white;"/>
                            <TableColumn fx:id="contractTermsColumn" text="Conditions" style="-fx-background-color: #9370DB; -fx-text-fill: #C71585;"/>
        </columns>
    </TableView>
                </VBox>
            </VBox>
        </StackPane>
    </HBox>

    <!-- Status Bar -->
    <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: #9370DB; -fx-padding: 10; -fx-background-radius: 5;">
        <Text fx:id="statusText" style="-fx-text-fill: #C71585;"/>
    </HBox>
</VBox>