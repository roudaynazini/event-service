<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.paint.Color?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.roudaynazini.MainViewController"
      spacing="10"
      style="-fx-background-color: #f5f5f5;">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <!-- Tab Pane for Navigation -->
    <TabPane fx:id="mainTabPane" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 5;">
        <!-- Reservations Tab -->
        <Tab text="Reservations" closable="false">
            <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 15;">
                <!-- Search and Filter Section -->
                <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-background-color: #f8f9fa; -fx-padding: 10; -fx-background-radius: 5;">
                    <Label text="Search:" style="-fx-font-weight: bold; -fx-text-fill: #495057;"/>
                    <TextField fx:id="reservationSearchField" promptText="Search by client name..." HBox.hgrow="ALWAYS" 
                             style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #dee2e6;"/>
                    <ComboBox fx:id="reservationStatusFilter" promptText="Filter by status" 
                             style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #dee2e6;"/>
                    <DatePicker fx:id="reservationDateFilter" promptText="Filter by date" 
                              style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #dee2e6;"/>
                    <Button text="Clear Filters" onAction="#handleClearReservationFilters" 
                            style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-background-radius: 5;"/>
                </HBox>

                <!-- Reservation Management Buttons -->
                <HBox spacing="15">
                    <Button text="Add Reservation" onAction="#handleAddReservation" 
                            style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-background-radius: 5;"/>
                    <Button text="Edit Reservation" onAction="#handleEditReservation" 
                            style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-background-radius: 5;"/>
                    <Button text="Delete Reservation" onAction="#handleDeleteReservation" 
                            style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-background-radius: 5;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="View Contracts" onAction="#handleViewContractsForReservation" 
                            style="-fx-background-color: #17a2b8; -fx-text-fill: white; -fx-background-radius: 5;"/>
                </HBox>

                <!-- Reservations Table -->
                <TableView fx:id="reservationTable" VBox.vgrow="ALWAYS" 
                          style="-fx-background-color: white; -fx-border-color: #dee2e6; -fx-border-radius: 5;">
                    <columns>
                        <TableColumn fx:id="idColumn" text="ID" prefWidth="50" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="nameColumn" text="Client Name" prefWidth="150" style="-fx-alignment: CENTER-LEFT;"/>
                        <TableColumn fx:id="dateColumn" text="Event Date" prefWidth="150" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="statusColumn" text="Status" prefWidth="100" style="-fx-alignment: CENTER;"/>
                    </columns>
                </TableView>
            </VBox>
        </Tab>

        <!-- Contracts Tab -->
        <Tab text="Contracts" closable="false">
            <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 15;">
                <!-- Search and Filter Section -->
                <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-background-color: #f8f9fa; -fx-padding: 10; -fx-background-radius: 5;">
                    <Label text="Search:" style="-fx-font-weight: bold; -fx-text-fill: #495057;"/>
                    <TextField fx:id="contractSearchField" promptText="Search by contract number..." HBox.hgrow="ALWAYS" 
                             style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #dee2e6;"/>
                    <ComboBox fx:id="contractTypeFilter" promptText="Filter by type" 
                             style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #dee2e6;"/>
                    <ComboBox fx:id="contractStatusFilter" promptText="Filter by status" 
                             style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #dee2e6;"/>
                    <Button text="Clear Filters" onAction="#handleClearContractFilters" 
                            style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-background-radius: 5;"/>
                </HBox>

                <!-- Contract Management Buttons -->
                <HBox spacing="15">
                    <Button text="Add Contract" onAction="#handleAddContract" 
                            style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-background-radius: 5;"/>
                    <Button text="Edit Contract" onAction="#handleEditContract" 
                            style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-background-radius: 5;"/>
                    <Button text="Delete Contract" onAction="#handleDeleteContract" 
                            style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-background-radius: 5;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="View Reservation" onAction="#handleViewReservationForContract" 
                            style="-fx-background-color: #17a2b8; -fx-text-fill: white; -fx-background-radius: 5;"/>
                </HBox>

                <!-- Contracts Table -->
                <TableView fx:id="contractTable" VBox.vgrow="ALWAYS" 
                          style="-fx-background-color: white; -fx-border-color: #dee2e6; -fx-border-radius: 5;">
                    <columns>
                        <TableColumn fx:id="contractIdColumn" text="ID" prefWidth="50" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="contractNumberColumn" text="Contract Number" prefWidth="150" style="-fx-alignment: CENTER-LEFT;"/>
                        <TableColumn fx:id="contractTypeColumn" text="Type" prefWidth="100" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="contractStatusColumn" text="Status" prefWidth="100" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="contractStartDateColumn" text="Start Date" prefWidth="100" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="contractEndDateColumn" text="End Date" prefWidth="100" style="-fx-alignment: CENTER;"/>
                    </columns>
                </TableView>
            </VBox>
        </Tab>
    </TabPane>

    <!-- Status Bar -->
    <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: #e9ecef; -fx-padding: 5; -fx-background-radius: 5;">
        <Text fx:id="statusText" style="-fx-font-size: 12px; -fx-fill: #495057;"/>
    </HBox>
</VBox> 