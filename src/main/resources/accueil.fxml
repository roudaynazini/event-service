<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<BorderPane prefHeight="600" prefWidth="1000" stylesheets="@/resources/css/style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.AccueilController">

    <!-- Menu latéral -->
    <left>
        <VBox alignment="TOP_CENTER" prefWidth="220" spacing="25" style="-fx-background-color: linear-gradient(to bottom, #8e44ad, #c39bd3); -fx-padding: 30; -fx-background-radius: 0 10 10 0;">
            <children>
                <Button styleClass="custom-button" text="🏠 Accueil" />
                <Button onAction="#goToAvis" text="🗣️ Avis" styleClass="custom-button" />
                <Button onAction="#goToReclamation" text="📨 Réclamations" styleClass="custom-button" />
                <Button text="Afficher Avis  Réclamations" onAction="#ouvrirAffichageAvisReclamations" styleClass="custom-button" />
                <Button text="🚪 Déconnexion" styleClass="custom-button" />
            </children>
        </VBox>
    </left>

    <!-- Contenu principal -->
    <center>
        <AnchorPane style="-fx-background-color: linear-gradient(to bottom right, #C8A2C8, #FFD1DC);">
            <children>
                <VBox alignment="CENTER" layoutX="100" layoutY="60" prefWidth="800" spacing="40">
                    <children>

                        <!-- Titre principal -->
                        <Text style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-fill: linear-gradient(to right, #6C3483, #A94ED1);" text="WELCOME" />

                        <!-- Conteneur des deux cadres -->
                        <HBox alignment="CENTER" spacing="60">
                            <children>

                                <!-- Cadre Avis -->
                                <VBox fx:id="avisBox" prefHeight="180" prefWidth="320" spacing="15" style="-fx-background-color: white; -fx-border-radius: 25px; -fx-background-radius: 25px; -fx-padding: 25px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 5);">
                                    <children>
                                        <Text style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-fill: #333;" text="Exprimez votre avis ✨" />
                                    </children>
                                </VBox>

                                <!-- Cadre Réclamation -->
                                <VBox fx:id="reclamationBox" prefHeight="180" prefWidth="320" spacing="15" style="-fx-background-color: white; -fx-border-radius: 25px; -fx-background-radius: 25px; -fx-padding: 25px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 5);">
                                    <children>
                                        <Text style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-fill: #333;" text="Signalez un souci 📝" />
                                    </children>
                                </VBox>

                            </children>
                        </HBox>

                    </children>
                </VBox>
            </children>
        </AnchorPane>
    </center>
</BorderPane>
